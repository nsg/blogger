{
  "id": "/",
  "name": "Blogger",
  "short_name": "Blogger",
  "description": "A self-hosted writing environment for Zola blogs.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#121212",
  "categories": ["productivity", "utilities"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
